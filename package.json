{
  "name": "openflyover",
  "private": true,
  "version": "0.0.0",
  "description": "Turn a GPS activity into a cinematic 3D flyover video, entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:fit": "node scripts/make-fit-fixture.ts",
    "sample:gpx": "node scripts/make-sample-gpx.ts",
    "sample:photos": "uv run --no-project --with pillow --with piexif --with pillow-heif python scripts/make-photos.py",
    "demo:capture": "node scripts/capture-demo.mjs",
    "demo:media": "uv run --no-project --with av --with pillow python scripts/make-demo-media.py",
    "android:sync": "pnpm build && cap sync android",
    "android:apk": "pnpm android:sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "exifr": "^7.1.3",
    "fit-file-parser": "^6.2.2",
    "heic-to": "^1.6.6",
    "maplibre-gl": "^6.14.0",
    "mediabunny": "^1.61.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
